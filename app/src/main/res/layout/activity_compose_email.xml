<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/composeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/compose_heading"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/compose_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/EmailLabel"
            android:text="@string/label_from" />

        <EditText
            android:id="@+id/editFrom"
            style="@style/EmailInput"
            android:autofillHints="emailAddress"
            android:hint="@string/hint_from"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/EmailLabel"
            android:text="@string/label_to" />

        <EditText
            android:id="@+id/editTo"
            style="@style/EmailInput"
            android:hint="@string/hint_to"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/EmailLabel"
            android:text="@string/label_cc" />

        <EditText
            android:id="@+id/editCc"
            style="@style/EmailInput"
            android:hint="@string/hint_cc"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/EmailLabel"
            android:text="@string/label_bcc" />

        <EditText
            android:id="@+id/editBcc"
            style="@style/EmailInput"
            android:hint="@string/hint_bcc"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/EmailLabel"
            android:text="@string/label_subject" />

        <EditText
            android:id="@+id/editSubject"
            style="@style/EmailInput"
            android:hint="@string/hint_subject"
            android:inputType="textCapSentences" />

        <TextView
            style="@style/EmailLabel"
            android:text="@string/label_body" />

        <EditText
            android:id="@+id/editBody"
            style="@style/EmailInput"
            android:gravity="top|start"
            android:hint="@string/hint_body"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonClear"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/button_clear" />

            <Button
                android:id="@+id/buttonPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/button_preview" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/developed_by"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
